#!/usr/bin/env python3
"""Run an ExtendScript (.jsx) script inside the open After Effects and print what it printed.

    ae-run script.jsx
    ae-run -c "print(app.project.numItems)"
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import ae_bridge

parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
parser.add_argument("script", nargs="?", help="path to a .jsx file to run in After Effects")
parser.add_argument("-c", dest="code", help="ExtendScript code to run in After Effects")
parser.add_argument("--timeout", type=int, default=600, help="seconds to wait for After Effects (default 600)")
args = parser.parse_args()
if bool(args.script) == bool(args.code):
    parser.error("give a script file or -c CODE (one of them)")

try:
    if args.code:
        output = ae_bridge.run(args.code, timeout=args.timeout)
    else:
        output = ae_bridge.run_file(args.script, timeout=args.timeout)
except (ae_bridge.AfterEffectsError, OSError) as error:
    sys.exit("ae-run: " + str(error))
if output:
    print(output)
